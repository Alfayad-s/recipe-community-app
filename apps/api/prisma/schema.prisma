generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Full ERD from the PRD will be added after schema design is finalized.
// This placeholder lets `prisma generate` succeed during project init.
model SchemaPlaceholder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("_schema_placeholder")
}

model Ingredient {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  category     String
  subCategory  String   @map("sub_category")
  imageUrl     String?  @map("image_url")
  cloudinaryId String?  @map("cloudinary_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([category, subCategory])
  @@map("ingredients")
}

model Recipe {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  cuisine      String
  minutes      Int
  rating       Decimal  @db.Decimal(2, 1)
  servings     Int
  description  String
  imageUrl     String   @map("image_url")
  cloudinaryId String   @map("cloudinary_id")
  calories     Int
  proteinG     Int      @map("protein_g")
  carbsG       Int      @map("carbs_g")
  fatG         Int      @map("fat_g")
  ingredients  Json
  steps        Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([cuisine])
  @@map("recipes")
}
